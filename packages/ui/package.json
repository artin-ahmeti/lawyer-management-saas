{
  "name": "@lawfirm/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Design tokens + Tailwind preset shared by mobile (NativeWind) and web (Tailwind)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@lawfirm/config": "workspace:*",
    "typescript": "~6.0.3"
  }
}
