    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "turbo": "^2.10.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.1.0"
  }
}
