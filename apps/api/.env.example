# Local Supabase stack (supabase start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Server-side only. NEVER expose to any client app. (Plan §3)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Same private deployment Redis and database connection target as the worker.
# If REDIS_URL is omitted, processing availability is explicitly unconfigured.
REDIS_URL=redis://127.0.0.1:6379

PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
NODE_ENV=development

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
