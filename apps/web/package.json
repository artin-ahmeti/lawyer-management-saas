{
  "name": "@lawfirm/web",
  "version": "0.0.1",
  "private": true,
  "description": "Clepso staff web app — Next.js over @lawfirm/ui-web; reads via supabase-js + RLS, writes via the NestJS API",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.contracts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lawfirm/api-client": "workspace:*",
    "@lawfirm/core": "workspace:*",
    "@lawfirm/ui-web": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@tanstack/react-query": "^5.104.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lawfirm/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
