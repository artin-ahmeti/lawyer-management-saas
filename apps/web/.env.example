# Supabase (anon/publishable key only — the service-role key never reaches a client app)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NestJS API (all writes go through it)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
# Set to 1 to open the app with the H1 mock data and no sign-in (local design review only)
NEXT_PUBLIC_PREVIEW=0
