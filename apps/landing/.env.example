# Clepso landing (apps/landing). Copy to .env.local for development.
# Every value is optional in the preview stage; a production-stage build fails
# while any launch blocker is open (see src/config/launch.ts).

# preview (default: noindex, "Preview build" label) | production
NEXT_PUBLIC_SITE_STAGE=preview
# Only honoured in the production stage.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Canonical origin, e.g. the approved marketing domain. Do not guess one.
NEXT_PUBLIC_SITE_URL=

# signup (primary action "Get started") | early-access ("Request early access" + enquiry form)
NEXT_PUBLIC_LAUNCH_MODE=signup
# The staff web app's routes. Locally: http://localhost:3100/sign-up and /sign-in
NEXT_PUBLIC_SIGN_UP_URL=
NEXT_PUBLIC_LOGIN_URL=

# Early-access enquiries are forwarded server-side to this endpoint (for example a
# future NestJS API route or a form service). Unset = the form reports that nothing
# was sent. Never a Supabase write from this app.
EARLY_ACCESS_ENDPOINT=
EARLY_ACCESS_TOKEN=

# Footer destinations. Leave empty until the real pages exist; empty links are hidden.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
