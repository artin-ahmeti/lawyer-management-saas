# EXPO_PUBLIC_* vars are bundled into the app — anon key only, NEVER the service role key (Plan §3)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# Set to 1 only for a local debug build to open the H1 design with mock data.
EXPO_PUBLIC_H1_PREVIEW=0
